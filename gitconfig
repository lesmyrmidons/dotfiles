[user]
    name = lesmyrmidons
    email = lesmyrmidons@gmail.com
    signingkey = ~/.ssh/id_ed25519.pub

[includeIf "gitdir:~/.setup/"]
    path = ~/.setup/dotfiles-custom/.gitconfig-github

[includeIf "gitdir:~/Projects/arcons/"]
    path = ~/.setup/dotfiles-custom/.gitconfig-arcons

[includeIf "gitdir:~/Projects/client/dnum/"]
    path = ~/.setup/dotfiles-custom/.gitconfig-dnum

[includeIf "gitdir:~/Projects/opensource/"]
    path = ~/.setup/dotfiles-custom/.gitconfig-github

[color]
    ui = true
    branch = auto
    diff = auto
    interactive = auto
    status = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "status"]
    added = green
    changed = yellow
    untracked = red

[core]
    editor = vim
    whitespace = trailing-space,space-before-tab
    excludesfile = ~/.gitignore_global
    # fileMode = false         # To ignore all file access rights changes

[help]
    autocorrect = 1

[merge]
    tool = vimdiff

[tig]
    show-date = "relative"      # Show relative commit date.
    show-author = "abbreviated"
    line-graphics = no
    line-number-interval = 5    # Interval between line numbers
    horizontal-scroll = 33%     # Scroll 33% of the view width
    tab-size = 4

[alias]
    st = status
    ci = commit
    co = checkout
    br = branch
    bra = branch --all
    lga = log --decorate --stat --graph --pretty=format:\"%d %Cgreen%h%Creset (%ar - %Cred%an%Creset), %s%n\"
    lg = log --decorate --graph --format='%Cgreen%h%Creset %ad %C(cyan)%an%Creset - %s%C(red)%d%Creset' --date=short
    lb = log --graph --pretty=format:'%Cred%h%Creset - %C(bold blue)%an%Creset -%C(auto)%d%Creset %s %Cgreen(%cr)' --abbrev-commit
    l = log --graph --pretty=format:'%Cred%h%Creset - %C(bold blue)%an%Creset -%C(auto)%d%Creset %s %Cgreen(%cr)' --abbrev-commit --all
    ll = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)an>%Creset' --abbrev-commit
    stat = shortlog -sne
    oups = reset HEAD^

[push]
    default = simple
    followTags = true

[init]
    defaultBranch = main
[credential "https://gitlab.arcons.io"]
    helper = 
    helper = !/home/lesmyrmidons/.local/bin/glab auth git-credential
[gpg]
    format = ssh
